# MongoDB connection string
MONGO_URL=mongodb+srv://

# Database name
MONGO_DB_NAME=ai_ovr

# JWT secret key used to sign tokens
JWT_SECRET_KEY=change_me_to_a_long_random_secret

# JWT algorithm
JWT_ALGORITHM=HS256

# Access token expiry in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=60

# SendGrid API key for email sending
SENDGRID_API_KEY=

# Sender email address used for outgoing mail
EMAIL_FROM=no-reply@example.com

# Frontend base URL (used in email links)
FRONTEND_URL=http://localhost:3000

# OpenAI API key (uncomment when AI model is ready)
# OPENAI_API_KEY=

# Anthropic API key (uncomment when AI model is ready)
# ANTHROPIC_API_KEY=

# Google Generative AI API key (uncomment when AI model is ready)
# GOOGLE_GENERATIVEAI_API_KEY=
