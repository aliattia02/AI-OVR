# MongoDB connection string
MONGO_URL=mongodb+srv://

# Database name (preferred)
DB_NAME=ai_ovr
# Legacy fallback (used only if DB_NAME is empty)
MONGO_DB_NAME=ai_ovr

# Deployment environment
ENVIRONMENT=development

# Allowed CORS origins (comma-separated). Required in production.
# Example: https://app.example.com,https://admin.example.com
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# JWT secret key used to sign tokens
# Precedence: JWT_SECRET is used first; JWT_SECRET_KEY is legacy fallback only.
JWT_SECRET=change_me_to_a_long_random_secret
# Backward-compatible fallback (legacy): JWT_SECRET_KEY
# JWT_SECRET_KEY=change_me_to_a_long_random_secret

# JWT algorithm

JWT_ALGORITHM=HS256

# Access token expiry in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=15  # 15 min — system design requirement, healthcare security compliance

# Refresh token expiry in days
REFRESH_TOKEN_EXPIRE_DAYS=30

# SendGrid API key for email sending
SENDGRID_API_KEY=

# Sender email address used for outgoing mail
EMAIL_FROM=no-reply@example.com
# Preferred sender email (used if set)
SENDGRID_FROM_EMAIL=no-reply@example.com

# Frontend base URL (used in email links)
FRONTEND_URL=http://localhost:3000

# AI provider: none | openai | anthropic | google
AI_PROVIDER=none

# API key for the chosen AI provider (leave blank to keep AI dormant)
AI_API_KEY=

# Model name for the chosen provider (leave blank to use the service default)
# OpenAI default:    gpt-4o-mini
# Anthropic default: claude-3-haiku-20240307
# Google default:    gemini-1.5-flash
AI_MODEL=

# Optional CSFLE (Client-Side Field Level Encryption) for incidents.medical_file_number
# Set CSFLE_ENABLED=true and provide a base64-encoded 96-byte local master key.
CSFLE_ENABLED=false
CSFLE_LOCAL_MASTER_KEY=
CSFLE_KEY_VAULT_NAMESPACE=encryption.__keyVault

# Optional font path for Arabic PDF exports
PDF_ARABIC_FONT_PATH=
