# Copy to .env. Never commit. REQUIRED vars cause startup error.

# =========================
# REQUIRED
# =========================
MONGO_URL=mongodb+srv:// # [REQUIRED] MongoDB connection string (URI)
DB_NAME=ai_ovr # [REQUIRED] Database name (string)
MONGO_DB_NAME=ai_ovr # [OPTIONAL] Legacy fallback if DB_NAME is empty

# =========================
# JWT
# =========================
JWT_SECRET=change_me_to_a_long_random_secret # [REQUIRED] Long random string for signing JWTs
# JWT_SECRET_KEY=change_me_to_a_long_random_secret # [OPTIONAL] Legacy fallback if JWT_SECRET is empty
JWT_ALGORITHM=HS256 # [OPTIONAL] Algorithm name (e.g., HS256)
ACCESS_TOKEN_EXPIRE_MINUTES=15 # [OPTIONAL] Integer minutes until access token expiry
REFRESH_TOKEN_EXPIRE_DAYS=30 # [OPTIONAL] Integer days until refresh token expiry

# =========================
# CORS & DEPLOYMENT
# =========================
ENVIRONMENT=development # [OPTIONAL] development|production
CORS_ORIGINS=http://localhost:3000,http://localhost:5173 # [OPTIONAL] Comma-separated origins (required in production)
FRONTEND_URL=http://localhost:3000 # [OPTIONAL] Base URL used in emails

# =========================
# OPTIONAL INTEGRATIONS
# =========================
SENDGRID_API_KEY= # [OPTIONAL] SendGrid API key (starts with SG.)
SENDGRID_FROM_EMAIL=no-reply@example.com # [OPTIONAL] Sender email address
EMAIL_FROM=no-reply@example.com # [OPTIONAL] Legacy sender email fallback
PDF_ARABIC_FONT_PATH= # [OPTIONAL] Absolute path to a .ttf font for Arabic PDFs

# =========================
# AI (deferred — AI_PROVIDER=none)
# =========================
AI_PROVIDER=none # [OPTIONAL] none|openai|anthropic|google
AI_API_KEY= # [OPTIONAL] Provider API key (leave blank when AI_PROVIDER=none)
AI_MODEL= # [OPTIONAL] Model name override (provider default if empty)

# =========================
# CSFLE
# =========================
CSFLE_ENABLED=false # [OPTIONAL] true|false to enable client-side field level encryption
# python -c "import os,base64; print(base64.b64encode(os.urandom(96)).decode())"
CSFLE_LOCAL_MASTER_KEY= # [OPTIONAL] Base64-encoded 96-byte key
CSFLE_KEY_VAULT_NAMESPACE=encryption.__keyVault # [OPTIONAL] Namespace for the key vault (db.collection)
